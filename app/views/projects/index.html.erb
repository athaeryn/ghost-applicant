<% content_for :title, "Projects" %>

<div class="flex items-start justify-between gap-4">
  <h1 class="text-2xl font-bold">Projects</h1>
  <div class="flex shrink-0 items-center gap-3 text-sm text-stone-400">
    <%= link_to "New project", new_admin_project_path, class: "underline hover:text-stone-600" %>
  </div>
</div>

<% if @projects.any? %>
  <div class="mt-6 space-y-3">
    <% @projects.each do |project| %>
      <%= link_to project_path(project), class: "block rounded-lg border border-stone-200 bg-white hover:border-stone-300" do %>
        <div class="p-4 pb-0">
          <div class="flex items-baseline justify-between gap-2 text-stone-400">
            <span class="space-x-0.5">
            <span class="font-semibold text-stone-700"><%= project.title %></span>
            <% if project.role.present? %>
              <span>&commat;</span>
              <span class="font-medium text-stone-500"><%= project.role.company %></span>
            <% end %>
            </span>

            <span class="shrink-0 text-xs text-stone-400"><%= project.status %></span>
          </div>
          <p class="mt-1 text-sm text-stone-600">
            <%= project.summary.presence || truncate(project.body, length: 160) %>
          </p>
        </div>

        <div class="mt-3 flex space-x-5 text-stone-500 text-xs font-semibold bg-gray-200 px-4 pt-2 py-2 rounded-b-lg">
          <div>
            <p class="">
            <span>Tag(s): </span>
              <%= project.tag_list.count %>
            </p>
          </div>
          <div>
            <p class="">
            <span>Post(s): </span>
              <%= project.posts_count %>
            </p>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
<% else %>
  <p class="mt-6 text-stone-500">No projects yet.</p>
<% end %>
