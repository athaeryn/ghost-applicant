<% content_for :title, "Projects" %>

<div class="flex items-start justify-between gap-4">
  <h1 class="text-2xl font-bold">Projects</h1>
  <div class="flex shrink-0 items-center gap-3 text-sm text-stone-400">
    <%= link_to "New project", new_admin_project_path, class: "underline hover:text-stone-600" %>
  </div>
</div>

<% if @projects.any? %>
  <div class="mt-6 space-y-3">
    <% @projects.each do |project| %>
      <%= link_to project_path(project), class: "block rounded-lg border border-stone-200 bg-white p-4 hover:border-stone-300" do %>
        <div class="flex items-baseline justify-between gap-2">
          <span class="font-medium"><%= project.title %></span>
          <span class="shrink-0 text-xs text-stone-400"><%= project.status %></span>
        </div>
        <p class="mt-1 text-sm text-stone-600">
          <%= project.summary.presence || truncate(project.body, length: 160) %>
        </p>
      <% end %>
    <% end %>
  </div>
<% else %>
  <p class="mt-6 text-stone-500">No projects yet.</p>
<% end %>
