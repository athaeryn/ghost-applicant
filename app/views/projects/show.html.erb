<% content_for :title, @project.title %>

<article>
  <h1 class="text-2xl font-bold"><%= @project.title %></h1>
  <div class="mt-2 flex flex-wrap items-center gap-2 text-sm text-stone-400">
    <span><%= @project.status %></span>
    <% dates = [@project.started_at, @project.ended_at].compact.presence %>
    <span><%= dates&.map { |d| human_date(d) }&.join(" – ") %></span>
    <% if @project.url.present? %>
      <%= link_to @project.url, @project.url, target: "_blank", rel: "noopener", class: "text-blue-600 underline" %>
    <% end %>
  </div>
  <%= render "shared/tags", tags: @project.tag_list %>

  <% if @project.role.present? %>
    <p class="mt-2 text-sm text-stone-600">
      At <%= link_to @project.role.display_name, role_path(@project.role), class: "underline" %>
    </p>
  <% end %>

  <% if @project.posts.any? %>
    <p class="mt-2 text-sm text-stone-600">
      <span class="text-stone-400">Mentioned in:</span>
      <% @project.posts.each do |post| %>
        <%= link_to post.title, post_path(post), class: "underline" %>
      <% end %>
    </p>
  <% end %>

  <div class="prose mt-6"><%= markdown(@project.body) %></div>
</article>