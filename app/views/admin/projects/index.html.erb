<div class="flex items-center justify-between">
  <h1 class="text-2xl font-bold">Projects</h1>
  <%= link_to "New project", new_admin_project_path, class: "rounded bg-stone-900 px-4 py-2 text-sm text-white hover:bg-stone-700" %>
</div>

<ul class="mt-6 divide-y divide-stone-200">
  <% @projects.each do |project| %>
    <li class="flex items-baseline justify-between gap-3 py-3">
      <div>
        <span class="font-medium"><%= link_to project.title, edit_admin_project_path(project), class: "text-stone-900 hover:underline" %></span>
        <span class="text-xs text-stone-400"><%= project.status %></span>
      </div>
      <div class="flex shrink-0 items-center gap-3 text-sm">
        <%= link_to "Edit", edit_admin_project_path(project), class: "text-stone-600 hover:underline" %>
        <%= link_to "View", project_path(project), class: "text-stone-600 hover:underline" %>
        <%= button_to "Delete", admin_project_path(project), method: :delete,
              data: { turbo_confirm: "Delete this project?" },
              class: "text-red-600 hover:underline" %>
      </div>
    </li>
  <% end %>
</ul>