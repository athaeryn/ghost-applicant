<% content_for :title, "New taxonomy" %>
<h1 class="mb-6 text-2xl font-bold">New taxonomy</h1>
<%= render "admin/shared/errors", object: @taxonomy %>
<%= form_with model: @taxonomy, url: admin_taxonomies_path do |f| %>
  <div>
    <%= f.label :name, class: "mb-1 block text-sm font-medium text-stone-700" %>
    <%= f.text_field :name, placeholder: "e.g. skill, topic, industry", class: "w-full rounded border border-stone-300 px-3 py-2 text-sm focus:border-stone-500 focus:outline-none" %>
  </div>
  <div class="mt-4">
    <%= f.label :description, class: "mb-1 block text-sm font-medium text-stone-700" %>
    <%= f.text_area :description, rows: 3, class: "w-full rounded border border-stone-300 px-3 py-2 text-sm focus:border-stone-500 focus:outline-none" %>
  </div>
  <div class="mt-6 flex items-center gap-3">
    <%= f.submit "Create taxonomy", class: "rounded bg-stone-900 px-4 py-2 text-sm text-white hover:bg-stone-700" %>
    <%= link_to "Cancel", admin_taxonomies_path, class: "text-sm text-stone-500 hover:underline" %>
  </div>
<% end %>