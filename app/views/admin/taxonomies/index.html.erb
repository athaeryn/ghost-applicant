<div class="flex items-center justify-between">
  <h1 class="text-2xl font-bold">Taxonomies</h1>
  <%= link_to "New taxonomy", new_admin_taxonomy_path, class: "rounded bg-stone-900 px-4 py-2 text-sm text-white hover:bg-stone-700" %>
</div>

<ul class="mt-6 divide-y divide-stone-200">
  <% @taxonomies.each do |taxonomy| %>
    <li class="flex items-baseline justify-between gap-3 py-3">
      <div>
        <span class="font-medium"><%= link_to taxonomy.name, admin_taxonomy_path(taxonomy), class: "text-stone-900 hover:underline" %></span>
        <span class="ml-2 text-xs text-stone-400"><%= pluralize(taxonomy.tags.size, "tag") %></span>
        <span class="block text-sm text-stone-500"><%= taxonomy.description %></span>
      </div>
      <div class="flex shrink-0 items-center gap-3 text-sm">
        <%= link_to "Open", admin_taxonomy_path(taxonomy), class: "text-stone-600 hover:underline" %>
        <%= button_to "Delete", admin_taxonomy_path(taxonomy), method: :delete,
              data: { turbo_confirm: "Delete this taxonomy and all its tags?" },
              class: "text-red-600 hover:underline" %>
      </div>
    </li>
  <% end %>
</ul>