<% content_for :title, @taxonomy.name %>
<div class="flex items-center justify-between">
  <h1 class="text-2xl font-bold"><%= @taxonomy.name %></h1>
  <%= link_to "All taxonomies", admin_taxonomies_path, class: "text-sm text-stone-500 hover:underline" %>
</div>
<p class="mt-1 text-stone-500"><%= @taxonomy.description %></p>

<section class="mt-6">
  <h2 class="text-sm font-semibold uppercase tracking-wider text-stone-400">Tags</h2>
  <ul class="mt-3 divide-y divide-stone-200">
    <% @taxonomy.tags.ordered.each do |tag| %>
      <li class="flex items-baseline justify-between gap-3 py-2">
        <span class="text-sm font-medium"><%= tag.name %></span>
        <div class="flex shrink-0 items-center gap-3 text-sm">
          <span class="text-xs text-stone-400"><%= pluralize(tag.taggings.count, "record") %></span>
          <%= button_to "Delete", admin_tag_path(tag), method: :delete,
                data: { turbo_confirm: "Delete this tag? It will be untagged everywhere." },
                class: "text-red-600 hover:underline" %>
        </div>
      </li>
    <% end %>
  </ul>

  <%= render "admin/shared/errors", object: @tag %>
  <%= form_with model: @tag, url: admin_tags_path do |f| %>
    <%= f.hidden_field :taxonomy_id, value: @taxonomy.id %>
    <div class="mt-6 flex items-end gap-3">
      <div class="flex-1">
        <%= f.label :name, class: "mb-1 block text-sm font-medium text-stone-700" %>
        <%= f.text_field :name, class: "w-full rounded border border-stone-300 px-3 py-2 text-sm focus:border-stone-500 focus:outline-none" %>
      </div>
      <div class="flex-1">
        <%= f.label :description, class: "mb-1 block text-sm font-medium text-stone-700" %>
        <%= f.text_field :description, class: "w-full rounded border border-stone-300 px-3 py-2 text-sm focus:border-stone-500 focus:outline-none" %>
      </div>
      <%= f.submit "Add tag", class: "rounded bg-stone-900 px-4 py-2 text-sm text-white hover:bg-stone-700" %>
    </div>
  <% end %>
</section>