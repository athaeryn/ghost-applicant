<% content_for :title, "Admin" %>

<div class="flex items-center justify-between">
  <h1 class="text-2xl font-bold">Admin</h1>
  <nav class="flex gap-4 text-sm text-stone-600">
    <%= link_to "Posts", admin_posts_path, class: "hover:text-stone-900" %>
    <%= link_to "Projects", admin_projects_path, class: "hover:text-stone-900" %>
    <%= link_to "Roles", admin_roles_path, class: "hover:text-stone-900" %>
    <%= link_to "Taxonomies", admin_taxonomies_path, class: "hover:text-stone-900" %>
  </nav>
</div>

<div class="mt-8 grid gap-6 sm:grid-cols-2">
  <section class="rounded-lg border border-stone-200 bg-white p-4">
    <h2 class="text-sm font-semibold uppercase tracking-wider text-stone-400">Posts (<%= Post.count %>)</h2>
    <ul class="mt-3 space-y-1 text-sm">
      <% @posts.each do |post| %>
        <li class="flex items-baseline justify-between gap-2">
          <%= link_to post.title, edit_admin_post_path(post), class: "text-stone-800 hover:underline" %>
          <span class="shrink-0 text-xs text-stone-400"><%= post.published? ? "published" : "draft" %></span>
        </li>
      <% end %>
    </ul>
    <%= link_to "New post", new_admin_post_path, class: "mt-3 inline-block text-sm font-medium text-blue-600 hover:underline" %>
  </section>

  <section class="rounded-lg border border-stone-200 bg-white p-4">
    <h2 class="text-sm font-semibold uppercase tracking-wider text-stone-400">Projects (<%= Project.count %>)</h2>
    <ul class="mt-3 space-y-1 text-sm">
      <% @projects.each do |project| %>
        <li class="flex items-baseline justify-between gap-2">
          <%= link_to project.title, edit_admin_project_path(project), class: "text-stone-800 hover:underline" %>
          <span class="shrink-0 text-xs text-stone-400"><%= project.status %></span>
        </li>
      <% end %>
    </ul>
    <%= link_to "New project", new_admin_project_path, class: "mt-3 inline-block text-sm font-medium text-blue-600 hover:underline" %>
  </section>

  <section class="rounded-lg border border-stone-200 bg-white p-4">
    <h2 class="text-sm font-semibold uppercase tracking-wider text-stone-400">Roles (<%= Role.count %>)</h2>
    <ul class="mt-3 space-y-1 text-sm">
      <% @roles.each do |role| %>
        <li class="flex items-baseline justify-between gap-2">
          <%= link_to "#{role.title}, #{role.company}", edit_admin_role_path(role), class: "text-stone-800 hover:underline" %>
        </li>
      <% end %>
    </ul>
    <%= link_to "New role", new_admin_role_path, class: "mt-3 inline-block text-sm font-medium text-blue-600 hover:underline" %>
  </section>

  <section class="rounded-lg border border-stone-200 bg-white p-4">
    <h2 class="text-sm font-semibold uppercase tracking-wider text-stone-400">Taxonomies (<%= Taxonomy.count %>)</h2>
    <ul class="mt-3 space-y-1 text-sm">
      <% @taxonomies.each do |taxonomy| %>
        <li><%= link_to taxonomy.name, admin_taxonomy_path(taxonomy), class: "text-stone-800 hover:underline" %></li>
      <% end %>
    </ul>
    <%= link_to "New taxonomy", new_admin_taxonomy_path, class: "mt-3 inline-block text-sm font-medium text-blue-600 hover:underline" %>
  </section>
</div>