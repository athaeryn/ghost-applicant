<%= render "admin/shared/errors", object: @job_application if @job_application.errors.any? %>

<%= form_with model: @job_application, url: [ :admin, @job_application ], class: "mt-4" do |f| %>
  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <%= f.label :company, class: "mb-1 block text-sm font-medium text-stone-700" %>
      <%= f.text_field :company, class: "w-full rounded border border-stone-300 px-3 py-2 text-sm focus:border-stone-500 focus:outline-none" %>
    </div>
    <div>
      <%= f.label :title, "Role title", class: "mb-1 block text-sm font-medium text-stone-700" %>
      <%= f.text_field :title, class: "w-full rounded border border-stone-300 px-3 py-2 text-sm focus:border-stone-500 focus:outline-none" %>
    </div>
  </div>

  <div class="mt-4 grid gap-4 sm:grid-cols-3">
    <div class="sm:col-span-2">
      <%= f.label :url, "Job posting URL", class: "mb-1 block text-sm font-medium text-stone-700" %>
      <%= f.url_field :url, class: "w-full rounded border border-stone-300 px-3 py-2 text-sm focus:border-stone-500 focus:outline-none" %>
    </div>
    <div>
      <%= f.label :status, class: "mb-1 block text-sm font-medium text-stone-700" %>
      <%= f.select :status, JobApplication::STATUSES, {}, class: "w-full rounded border border-stone-300 px-3 py-2 text-sm focus:border-stone-500 focus:outline-none" %>
    </div>
  </div>

  <div class="mt-4">
    <%= f.label :description, "Job description (paste the posting)", class: "mb-1 block text-sm font-medium text-stone-700" %>
    <%= f.text_area :description, rows: 14, class: "w-full rounded border border-stone-300 px-3 py-2 text-sm font-mono text-stone-600 focus:border-stone-500 focus:outline-none" %>
  </div>

  <div class="mt-4">
    <%= f.label :notes, "Notes (markdown)", class: "mb-1 block text-sm font-medium text-stone-700" %>
    <%= f.text_area :notes, rows: 4, class: "w-full rounded border border-stone-300 px-3 py-2 text-sm focus:border-stone-500 focus:outline-none" %>
  </div>

  <div class="mt-4">
    <%= f.label :applied_at, "Applied on", class: "mb-1 block text-sm font-medium text-stone-700" %>
    <%= f.date_field :applied_at, class: "rounded border border-stone-300 px-3 py-2 text-sm focus:border-stone-500 focus:outline-none" %>
  </div>

  <div class="mt-4">
    <%= render "admin/shared/tags_input", object: @job_application, scope: :job_application %>
  </div>

  <div class="mt-6 flex gap-3">
    <%= f.submit "Save", class: "rounded bg-stone-900 px-4 py-2 text-sm text-white hover:bg-stone-700" %>
    <%= link_to "Cancel", @job_application.persisted? ? job_application_path(@job_application) : admin_job_applications_path,
          class: "rounded border border-stone-300 px-4 py-2 text-sm text-stone-600 hover:bg-stone-50" %>
  </div>
<% end %>