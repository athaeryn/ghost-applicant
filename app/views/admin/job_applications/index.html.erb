<div class="flex items-center justify-between">
  <h1 class="text-2xl font-bold">Job applications</h1>
  <%= link_to "New application", new_admin_job_application_path, class: "rounded bg-stone-900 px-4 py-2 text-sm text-white hover:bg-stone-700" %>
</div>

<ul class="mt-6 divide-y divide-stone-200">
  <% @job_applications.each do |application| %>
    <li class="flex items-baseline justify-between gap-3 py-3">
      <div>
        <span class="font-medium"><%= link_to application.label, edit_admin_job_application_path(application), class: "text-stone-900 hover:underline" %></span>
        <span class="text-xs text-stone-400"><%= application.status %><%= application.applied_at ? " · applied #{application.applied_at.strftime("%b %d, %Y")}" : "" %></span>
      </div>
      <div class="flex shrink-0 items-center gap-3 text-sm">
        <%= link_to "Edit", edit_admin_job_application_path(application), class: "text-stone-600 hover:underline" %>
        <%= link_to "View", job_application_path(application), class: "text-stone-600 hover:underline" %>
        <%= button_to "Delete", admin_job_application_path(application), method: :delete,
              data: { turbo_confirm: "Delete this application and its drafts?" },
              class: "text-red-600 hover:underline" %>
      </div>
    </li>
  <% end %>
</ul>