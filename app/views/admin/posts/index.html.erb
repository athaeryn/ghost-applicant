<div class="flex items-center justify-between">
  <h1 class="text-2xl font-bold">Posts</h1>
  <%= link_to "New post", new_admin_post_path, class: "rounded bg-stone-900 px-4 py-2 text-sm text-white hover:bg-stone-700" %>
</div>

<ul class="mt-6 divide-y divide-stone-200">
  <% @posts.each do |post| %>
    <li class="flex items-baseline justify-between gap-3 py-3">
      <div>
        <span class="font-medium"><%= link_to post.title, edit_admin_post_path(post), class: "text-stone-900 hover:underline" %></span>
        <span class="text-xs text-stone-400"><%= post.published? ? "published #{post.published_at&.strftime("%b %d, %Y")}" : "draft" %></span>
      </div>
      <div class="flex shrink-0 items-center gap-3 text-sm">
        <%= link_to "Edit", edit_admin_post_path(post), class: "text-stone-600 hover:underline" %>
        <%= link_to "View", post_path(post), class: "text-stone-600 hover:underline" %>
        <%= button_to "Delete", admin_post_path(post), method: :delete,
              data: { turbo_confirm: "Delete this post?" },
              class: "text-red-600 hover:underline" %>
      </div>
    </li>
  <% end %>
</ul>