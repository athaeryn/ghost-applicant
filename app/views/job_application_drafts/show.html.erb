<% content_for :title, "#{@draft.kind.titleize} draft for #{@job_application.label}" %>

<article>
  <div class="flex items-start justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold"><%= @draft.kind.titleize %> draft</h1>
      <p class="mt-1 text-sm text-stone-500">
        <%= @job_application.label %> · <%= @draft.created_at.strftime("%B %d, %Y") %>
        <% if @draft.label.present? %><span class="rounded-full bg-stone-100 px-2 py-0.5 text-xs text-stone-600"><%= @draft.label %></span><% end %>
      </p>
    </div>
    <div class="flex shrink-0 items-center gap-3 text-sm">
      <button onclick="navigator.clipboard.writeText(<%= @draft.body.to_json %>).then(() => { this.textContent = 'Copied!'; setTimeout(() => { this.textContent = 'Copy markdown' }, 2000) })"
        class="text-stone-600 hover:underline">Copy markdown</button>
      <%= button_to(@draft.favorited? ? "Unfavorite" : "Favorite",
            toggle_favorite_job_application_draft_path(@job_application, @draft),
            method: :post,
            class: @draft.favorited? ? "text-amber-600 hover:underline" : "text-stone-600 hover:underline") %>
      <%= button_to "Delete", job_application_draft_path(@job_application, @draft),
            method: :delete,
            data: { turbo_confirm: "Delete this draft?" },
            class: "text-red-600 hover:underline" %>
      <%= link_to "Back to application", job_application_path(@job_application),
            class: "text-stone-400 underline hover:text-stone-600" %>
    </div>
  </div>

  <% index = @drafts.index(@draft) %>
  <% if index && @drafts.length > 1 %>
    <div class="mt-3 flex gap-3 text-sm text-stone-500">
      <%= link_to "← Older", job_application_draft_path(@job_application, @drafts[index - 1]), class: "underline" if index > 0 %>
      <%= link_to "Newer →", job_application_draft_path(@job_application, @drafts[index + 1]), class: "underline" if @drafts[index + 1] %>
    </div>
  <% end %>

  <div class="prose mt-6"><%= markdown(@draft.body) %></div>

  <% if @draft.selection.present? %>
    <section class="mt-8 rounded-lg border border-stone-200 bg-white p-6">
      <details class="group">
        <summary class="cursor-pointer text-base font-bold text-stone-900 select-none flex items-center justify-between">
          <span>Relevance Selection Rationale</span>
          <span class="text-xs text-stone-400 group-open:rotate-180 transition-transform">▼</span>
        </summary>
        <div class="mt-4 space-y-3 text-sm">
          <% sel = @draft.selection.with_indifferent_access %>
          <% entries = Array(sel[:selected]) %>
          <% role_ids = entries.select { |s| s[:type] == "role" }.map { |s| s[:id] } %>
          <% project_ids = entries.select { |s| s[:type] == "project" }.map { |s| s[:id] } %>
          <% post_ids = entries.select { |s| s[:type] == "post" }.map { |s| s[:id] } %>
          <% roles = Role.where(id: role_ids).index_by(&:id) %>
          <% projects = Project.where(id: project_ids).index_by(&:id) %>
          <% posts = Post.where(id: post_ids).index_by(&:id) %>
          <% name_of = ->(s) do
            case s[:type]
            when "role" then roles[s[:id]]&.display_name
            when "project" then projects[s[:id]]&.title
            when "post" then posts[s[:id]]&.title
            end
          end %>
          <% if sel[:fallback] %>
            <p class="text-amber-700">Tag-intersection fallback used (selector was unavailable).</p>
          <% else %>
            <p class="text-stone-600">
              <%= entries.count { |s| s[:relevance].to_i >= 1 } %> records kept, 
              <%= entries.count { |s| s[:relevance].to_i == 0 } %> omitted. 
              All roles always included.
            </p>
            <% if sel[:notes].present? %>
              <p class="text-stone-500 italic"><%= sel[:notes] %></p>
            <% end %>
            <ul class="mt-3 divide-y divide-stone-100">
              <% entries.each do |s| %>
                <li class="py-2 flex items-baseline justify-between gap-4 <%= s[:relevance].to_i == 0 ? "text-stone-400 line-through" : "text-stone-800" %>">
                  <div>
                    <span class="font-semibold"><%= name_of.call(s) || "#{s[:type]} ##{s[:id]}" %></span>
                    <span class="ml-1.5 font-mono text-xs uppercase text-stone-500">#<%= s[:id] %></span>
                    <span class="ml-2 text-xs font-semibold px-1.5 py-0.5 rounded bg-stone-100 text-stone-600">rel: <%= s[:relevance] %></span>
                    <p class="mt-0.5 text-xs text-stone-600"><%= s[:reason] %></p>
                  </div>
                </li>
              <% end %>
            </ul>
          <% end %>
        </div>
      </details>
    </section>
  <% end %>

  <hr class="my-10 border-stone-200">

  <section class="rounded-lg border border-stone-200 bg-white p-6">
    <h2 class="text-lg font-bold text-stone-900">Request Redraft</h2>
    <p class="mt-1 text-sm text-stone-500">Provide feedback to generate a new iteration of this draft in the background.</p>

    <%= form_with url: redraft_job_application_draft_path(@job_application, @draft), method: :post, class: "mt-4 space-y-4" do |f| %>
      <div>
        <label class="block text-sm font-medium text-stone-700">General feedback (tone, length, focus)</label>
        <%= f.text_area :general_feedback, rows: 2, placeholder: "e.g., Make the opening paragraph punchier and emphasize leadership.", class: "mt-1 block w-full rounded-md border border-stone-300 p-2 text-sm shadow-sm focus:border-blue-500 focus:ring-blue-500" %>
      </div>

      <div>
        <label class="block text-sm font-medium text-stone-700">Selection feedback (optional: request re-selection)</label>
        <%= f.text_area :selection_feedback, rows: 2, placeholder: "e.g., Include the recent project at Beta Corp and omit the early freelance work.", class: "mt-1 block w-full rounded-md border border-stone-300 p-2 text-sm shadow-sm focus:border-blue-500 focus:ring-blue-500" %>
        <p class="mt-1 text-xs text-stone-400">Entering text here triggers a fresh relevance selector pass incorporating your instructions.</p>
      </div>

      <div>
        <%= f.submit "Queue Redraft Task", class: "rounded bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700" %>
      </div>
    <% end %>
  </section>
</article>