<% content_for :title, "#{@draft.kind.titleize} draft for #{@job_application.label}" %>

<article>
  <div class="flex items-start justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold"><%= @draft.kind.titleize %> draft</h1>
      <p class="mt-1 text-sm text-stone-500">
        <%= @job_application.label %> · <%= @draft.created_at.strftime("%B %d, %Y") %>
        <% if @draft.label.present? %><span class="rounded-full bg-stone-100 px-2 py-0.5 text-xs text-stone-600"><%= @draft.label %></span><% end %>
      </p>
    </div>
    <div class="flex shrink-0 items-center gap-3 text-sm">
      <button onclick="navigator.clipboard.writeText(<%= @draft.body.to_json %>).then(() => { this.textContent = 'Copied!'; setTimeout(() => { this.textContent = 'Copy markdown' }, 2000) })"
        class="text-stone-600 hover:underline">Copy markdown</button>
      <%= button_to(@draft.favorited? ? "Unfavorite" : "Favorite",
            toggle_favorite_job_application_draft_path(@job_application, @draft),
            method: :post,
            class: @draft.favorited? ? "text-amber-600 hover:underline" : "text-stone-600 hover:underline") %>
      <%= button_to "Delete", job_application_draft_path(@job_application, @draft),
            method: :delete,
            data: { turbo_confirm: "Delete this draft?" },
            class: "text-red-600 hover:underline" %>
      <%= link_to "Back to application", job_application_path(@job_application),
            class: "text-stone-400 underline hover:text-stone-600" %>
    </div>
  </div>

  <% index = @drafts.index(@draft) %>
  <% if index && @drafts.length > 1 %>
    <div class="mt-3 flex gap-3 text-sm text-stone-500">
      <%= link_to "← Older", job_application_draft_path(@job_application, @drafts[index - 1]), class: "underline" if index > 0 %>
      <%= link_to "Newer →", job_application_draft_path(@job_application, @drafts[index + 1]), class: "underline" if @drafts[index + 1] %>
    </div>
  <% end %>

  <div class="prose mt-6"><%= markdown(@draft.body) %></div>
</article>