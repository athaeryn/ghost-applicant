<% if tags.present? %>
  <div class="mt-3 flex flex-wrap gap-1.5">
    <% tags.each do |label| %>
      <% taxonomy, _, tag = label.partition(":") %>
      <%= link_to tag, tag_path(taxonomy.parameterize, tag.parameterize),
            class: "rounded-full bg-stone-100 px-2.5 py-1 text-xs text-stone-600 hover:bg-stone-200" %>
    <% end %>
  </div>
<% end %>