<% content_for :title, @job_application.label %>

<article>
  <div class="flex items-start justify-between gap-4">
    <h1 class="text-2xl font-bold"><%= @job_application.label %></h1>
    <%= link_to "Edit in admin", edit_admin_job_application_path(@job_application),
          class: "shrink-0 text-sm text-stone-400 underline hover:text-stone-600" %>
  </div>

  <div class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-stone-500">
    <span class="uppercase tracking-wide"><%= @job_application.status %></span>
    <span><%= @job_application.applied_at&.strftime("%B %d, %Y") %></span>
    <% if @job_application.url.present? %>
      <%= link_to "Original posting", @job_application.url, target: "_blank", rel: "noopener", class: "text-blue-600 underline" %>
    <% end %>
  </div>

  <% if @job_application.description.present? %>
    <div class="mt-8">
      <h2 class="text-sm font-semibold uppercase tracking-wider text-stone-400">Job description</h2>
      <div class="mt-2 border border-2 border-gray-200 bg-white p-4 rounded-xl"><div class="prose"><%= markdown(@job_application.description) %></div></div>
    </div>
  <% end %>

  <div class="mt-4">
    <h2 class="text-sm font-semibold uppercase tracking-wider text-stone-400">Tags</h2>
    <div class="mt-2 border border-2 border-gray-200 bg-white p-4 rounded-xl">
    <div class="flex flex-wrap items-center gap-1.5">
      <% @job_application.tag_list.each do |label| %>
        <span class="flex items-center gap-1.5 rounded-full bg-stone-100 px-2.5 py-1 text-xs text-stone-600">
          <%= label %>
          <%= button_to "×", remove_tag_job_application_path(@job_application, tag: label), method: :delete,
                class: "text-stone-400 hover:text-red-600", aria: { label: "Remove #{label}" } %>
        </span>
      <% end %>
    </div>
    <%= form_with url: add_tag_job_application_path(@job_application), class: "mt-3 flex gap-2" do %>
      <%= text_field_tag :tag, nil, placeholder: "taxonomy:name", class: "w-56 rounded border border-stone-300 px-3 py-1.5 text-sm focus:border-stone-500 focus:outline-none" %>
      <%= submit_tag "Add tag", class: "rounded bg-stone-900 px-3 py-1.5 text-sm text-white hover:bg-stone-700" %>
    <% end %>

    <div class="mt-8 flex gap-2">
      <%= button_to "Analyze", analyze_job_application_path(@job_application),
            method: :post,
            class: "rounded bg-stone-900 px-3 py-1.5 text-xs text-white hover:bg-stone-700" %>
    </div>

    <% if @job_application.gap_tags.present? %>
      <div class="mt-4">
        <h2 class="text-sm font-semibold tracking-wide text-stone-400">Gap tags</h2>
        <p class="mt-1 text-xs text-stone-400">Tags with no supporting records yet.</p>
        <div class="mt-2 flex flex-wrap gap-1.5">
          <% @job_application.gap_tags.split("\n").each do |tag| %>
            <span class="rounded-full bg-amber-50 px-2.5 py-1 text-xs text-amber-700"><%= tag %></span>
          <% end %>
        </div>
      </div>
    <% end %>
    </div>
  </div>


  <% if @job_application.notes.present? %>
    <div class="mt-8">
      <h2 class="text-sm font-semibold uppercase tracking-wider text-stone-400">Notes</h2>
      <div class="prose mt-2"><%= markdown(@job_application.notes) %></div>
    </div>
  <% end %>

  <% resumes = @job_application.application_drafts.resumes.chronological %>
  <% cover_letters = @job_application.application_drafts.cover_letters.chronological %>

  <div class="p-4 mt-4 flex space-x-5 border border-2 border-gray-200 bg-white rounded-xl">
    <div class="flex-1">
      <div class="">
        <h2 class="text-sm font-semibold uppercase tracking-wider text-stone-400 mb-2">Resume drafts</h2>
        <%= button_to "Generate resume draft", draft_job_application_path(@job_application),
              method: :post,
              class: "rounded bg-stone-700 px-3 py-1.5 text-sm text-white hover:bg-stone-500" %>
        <% if resumes.any? %>
          <ul class="mt-2 space-y-1 text-sm text-stone-600">
            <% resumes.each do |draft| %>
              <li class="flex items-center gap-2">
                <span class="<% if draft.favorited? %>text-amber-500<% else %>text-gray-200<% end %>">&#9733;</span>
                <%= link_to "#{draft.created_at.strftime("%b %d — %I:%M%P")}",
                      job_application_draft_path(@job_application, draft), class: "underline" %>
              </li>
            <% end %>
          </ul>
        <% end %>
      </div>
    </div>
    <div class="flex-1">
      <div class="">
        <h2 class="text-sm font-semibold uppercase tracking-wider text-stone-400 mb-2">Cover letter drafts</h2>
        <%= button_to "Generate cover letter", draft_cover_letter_job_application_path(@job_application),
              method: :post,
              class: "rounded bg-stone-700 px-3 py-1.5 text-sm text-white hover:bg-stone-500" %>
        <% if cover_letters.any? %>
          <ul class="mt-2 space-y-1 text-sm text-stone-600">
            <% cover_letters.each do |draft| %>
              <li class="flex items-center gap-2">
                <span class="<% if draft.favorited? %>text-amber-500<% else %>text-gray-200<% end %>">&#9733;</span>
                <%= link_to "#{draft.created_at.strftime("%b %d — %I:%M%P")}",
                      job_application_draft_path(@job_application, draft), class: "underline" %>
              </li>
            <% end %>
          </ul>
        <% end %>
      </div>
    </div>
  </div>
</article>
